# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# Long-lived Claude Code token for the on-call responder (incident-response/).
# Create one with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: model for responder investigations (default: Claude Code's default).
RESPONDER_CLAUDE_MODEL=

# Grafana admin password (default: admin).
GRAFANA_ADMIN_PASSWORD=
