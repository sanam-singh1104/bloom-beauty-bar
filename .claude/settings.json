{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-hooks/ruff-on-edit.sh\"",
            "timeout": 30,
            "statusMessage": "ruff: formatting and linting"
          }
        ]
      }
    ]
  }
}
